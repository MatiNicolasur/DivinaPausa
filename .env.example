# Resend configuration. Keep server-only; never prefix with PUBLIC_.
# Optional internal notifications; enable only after verifying the sender domain.
QUOTES_EMAIL_ENABLED=false
RESEND_API_KEY=
QUOTES_EMAIL_FROM=Divina Pausa <contacto@divinapausa.cl>
QUOTES_EMAIL_TO=contacto@divinapausa.cl

# Enable only in a controlled preview when explicitly testing delivery.
QUOTES_ALLOW_PREVIEW_SEND=false

# Turnstile: public site key is embedded at build time; secret is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
