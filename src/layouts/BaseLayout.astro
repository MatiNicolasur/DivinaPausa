---
import SitePreloader from '../components/SitePreloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { contact } from '../data/contactData';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Divina Pausa",
  description = "Catering para empresas y eventos. Ofrecemos servicios de catering para eventos y celebraciones en el lugar que prefieras. Contamos con un equipo de expertos en la preparación de comida gourmet y bebidas frescas.",
  keywords = "catering, empresas, eventos, celebraciones, comida gourmet, bebidas frescas, servicio, santiago, chile",
  ogImage = "/images/Hero Header.jpg"
} = Astro.props;

const siteName = "Divina Pausa";
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID?.trim();
// Para que Astro.site funcione, debes configurarlo en astro.config.mjs
// Ejemplo: export default defineConfig({ site: 'https://divinapausa.cl' });
const baseSiteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://divinapausa.cl'; // Fallback y quitar slash final si existe
const canonicalURL = new URL(Astro.url.pathname, baseSiteUrl).toString();
const finalOgImage = new URL(ogImage, baseSiteUrl).toString();
const organizationId = `${baseSiteUrl}/#organization`;
const business = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteName,
      legalName: 'Productos DivinaPausa SPA',
      url: baseSiteUrl,
      logo: new URL('/images/logos/Mesa de trabajo 5.svg', baseSiteUrl).toString(),
      email: contact.email,
      telephone: contact.phones[0].number,
      areaServed: { '@type': 'AdministrativeArea', name: 'Región Metropolitana de Santiago, Chile' },
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'cotizaciones',
        email: contact.email,
        telephone: contact.phones[0].number,
        availableLanguage: 'Spanish',
      }],
      sameAs: ['https://www.instagram.com/divinapausa.cl/', 'https://www.linkedin.com/company/divinapausa/'],
    },
    {
      '@type': 'WebSite',
      '@id': `${baseSiteUrl}/#website`,
      name: siteName,
      url: `${baseSiteUrl}/`,
      inLanguage: 'es-CL',
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#151515">

    <title>{`${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:locale" content="es_CL" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(business).replace(/</g, '\\u003c')} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:site_name" content={siteName} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    {/* <meta name="twitter:site" content="@tuTwitterHandle"> Opcional */}

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    {/* Estilos globales se importan en el frontmatter */}
    <slot name="head-extra" />


  </head>
  <body>
    <SitePreloader />
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div class="page-wrapper">
      <Header />

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>
    <style is:global>
      .page-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main#main-content {
        flex-grow: 1;
        padding-top: 125px; /* Ajusta este valor según la altura de tu header fijo */
      }
    </style>
    {pixelId && (
      <script define:vars={{ pixelId }}>
        if (/^\d+$/.test(pixelId) && typeof window.fbq !== 'function') {
          (function(f,b,e,v,n,t,s) {
            if (f.fbq) return;
            n = f.fbq = function() { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = true;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = true;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', pixelId);
          window.fbq('track', 'PageView');
        }
      </script>
    )}
  </body>
</html>
