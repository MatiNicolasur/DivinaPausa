---
import SitePreloader from '../components/SitePreloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { contact } from '../data/contactData';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Divina Pausa",
  description = "Catering para empresas y eventos. Ofrecemos servicios de catering para eventos y celebraciones en el lugar que prefieras. Contamos con un equipo de expertos en la preparación de comida gourmet y bebidas frescas.",
  keywords = "catering, empresas, eventos, celebraciones, comida gourmet, bebidas frescas, servicio, santiago, chile",
  ogImage = "/images/Hero Header.jpg"
} = Astro.props;

const siteName = "Divina Pausa";
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID?.trim();
// Para que Astro.site funcione, debes configurarlo en astro.config.mjs
// Ejemplo: export default defineConfig({ site: 'https://divinapausa.cl' });
const baseSiteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://divinapausa.cl'; // Fallback y quitar slash final si existe
const canonicalURL = new URL(Astro.url.pathname, baseSiteUrl).toString();
const finalOgImage = new URL(ogImage, baseSiteUrl).toString();
const organizationId = `${baseSiteUrl}/#organization`;
const business = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteName,
      legalName: 'Productos DivinaPausa SPA',
      url: baseSiteUrl,
      logo: new URL('/images/logos/Mesa de trabajo 5.svg', baseSiteUrl).toString(),
      email: contact.email,
      telephone: contact.phones[0].number,
      areaServed: { '@type': 'AdministrativeArea', name: 'Región Metropolitana de Santiago, Chile' },
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'cotizaciones',
        email: contact.email,
        telephone: contact.phones[0].number,
        availableLanguage: 'Spanish',
      }],
      sameAs: ['https://www.instagram.com/divinapausa.cl/', 'https://www.linkedin.com/company/divinapausa/'],
    },
    {
      '@type': 'WebSite',
      '@id': `${baseSiteUrl}/#website`,
      name: siteName,
      url: `${baseSiteUrl}/`,
      inLanguage: 'es-CL',
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#151515">

    <title>{`${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:locale" content="es_CL" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(business).replace(/</g, '\\u003c')} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:site_name" content={siteName} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    {/* <meta name="twitter:site" content="@tuTwitterHandle"> Opcional */}

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    {/* Estilos globales se importan en el frontmatter */}
    <slot name="head-extra" />


  </head>
  <body>
    <SitePreloader />
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div class="page-wrapper">
      <Header />

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>
    {pixelId && (
      <aside class="tracking-consent" id="tracking-consent" role="region" aria-label="Preferencias de medición" hidden>
        <div class="tracking-consent__content">
          <p class="tracking-consent__title">Tu privacidad importa</p>
          <p>Con tu permiso, Meta Pixel medirá visitas y solicitudes para evaluar nuestras campañas. No enviaremos a Meta el contenido ni los datos de contacto de tu cotización.</p>
          <a href="/politicas-de-privacidad/#cookies">Conoce cómo funciona</a>
          <div class="tracking-consent__actions">
            <button type="button" data-consent-reject>Solo necesarias</button>
            <button type="button" data-consent-accept>Aceptar medición</button>
          </div>
        </div>
      </aside>
    )}
    <style is:global>
      .page-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main#main-content {
        flex-grow: 1;
        padding-top: 125px; /* Ajusta este valor según la altura de tu header fijo */
      }
      .tracking-consent[hidden] { display: none; }
      .tracking-consent {
        position: fixed;
        z-index: 10000;
        right: max(20px, env(safe-area-inset-right));
        bottom: max(20px, env(safe-area-inset-bottom));
        left: max(20px, env(safe-area-inset-left));
        max-width: 620px;
        margin-left: auto;
        padding: 22px 24px;
        border: 1px solid #ffffff2a;
        border-radius: 20px;
        background: #171717;
        color: #fff;
        box-shadow: 0 18px 70px #0006;
        font: 400 .85rem/1.6 Poppins, sans-serif;
      }
      .tracking-consent__title { margin: 0 0 6px; font-family: 'Playfair Display', serif; font-size: 1.35rem; }
      .tracking-consent__content > p:not(.tracking-consent__title) { margin: 0; color: #e0d9d6; }
      .tracking-consent__content > a { display: inline-block; margin-top: 8px; color: #f0c3c0; text-underline-offset: 3px; }
      .tracking-consent__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 16px; }
      .tracking-consent__actions button { min-height: 42px; padding: 9px 16px; border: 1px solid #e5b1ae; border-radius: 999px; background: transparent; color: #fff; font: inherit; cursor: pointer; }
      .tracking-consent__actions button[data-consent-accept] { background: #e5b1ae; color: #212121; font-weight: 600; }
      .tracking-consent__actions button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      @media (max-width: 560px) {
        .tracking-consent { right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); left: 12px; padding: 18px; border-radius: 17px; }
        .tracking-consent__actions { display: grid; grid-template-columns: 1fr 1fr; }
        .tracking-consent__actions button { padding-inline: 8px; font-size: .77rem; }
      }
    </style>
    {pixelId && (
      <script define:vars={{ pixelId }}>
        (() => {
          const consentKey = 'dp-meta-pixel-consent-v1';
          const banner = document.getElementById('tracking-consent');
          if (!/^\d+$/.test(pixelId) || !banner) return;

          let choice = null;
          try { choice = localStorage.getItem(consentKey); } catch {}

          const loadPixel = () => {
            if (choice !== 'accepted' || typeof window.fbq === 'function') return;
            (function(f,b,e,v,n,t,s) {
              if (f.fbq) return;
              n = f.fbq = function() { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
              if (!f._fbq) f._fbq = n;
              n.push = n;
              n.loaded = true;
              n.version = '2.0';
              n.queue = [];
              t = b.createElement(e);
              t.async = true;
              t.src = v;
              s = b.getElementsByTagName(e)[0];
              s.parentNode.insertBefore(t, s);
            })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
            window.fbq('init', pixelId);
            window.fbq('track', 'PageView');
          };

          const saveChoice = (nextChoice) => {
            choice = nextChoice;
            try { localStorage.setItem(consentKey, choice); } catch {}
            banner.hidden = true;
            if (choice === 'accepted') loadPixel();
          };

          banner.querySelector('[data-consent-accept]')?.addEventListener('click', () => saveChoice('accepted'));
          banner.querySelector('[data-consent-reject]')?.addEventListener('click', () => saveChoice('rejected'));
          document.addEventListener('click', (event) => {
            const trigger = event.target instanceof Element ? event.target.closest('[data-open-cookie-preferences]') : null;
            if (!trigger) return;
            event.preventDefault();
            banner.hidden = false;
            banner.querySelector('[data-consent-accept]')?.focus();
          });
          if (choice === 'accepted') loadPixel();
          else if (choice !== 'rejected') banner.hidden = false;
        })();
      </script>
    )}
  </body>
</html>
