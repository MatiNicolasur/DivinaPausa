---
import CTASection from '../components/CTASection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const founders = '/images/fundadores/ce29d03b-f3a9-4cbc-9fdc-65b965eedaf1.JPG';
const chapters = [
  { id: 'personas', label: 'Las personas', title: 'Detrás de cada pausa, hay alguien que la cuida.', text: 'Divina Pausa tiene un lado muy personal: sus fundadores, presentes en los detalles y en la preparación. Esta imagen cuenta algo de nuestra forma de trabajar: estar ahí, poner las manos y cuidar lo que llega a la mesa.', image: founders, alt: 'Los dos fundadores de Divina Pausa preparando una mesa para un evento', caption: 'Nuestros fundadores, en la preparación de un encuentro.' },
  { id: 'cuidado', label: 'El cuidado', title: 'Lo pequeño también hace la diferencia.', text: 'Una mesa bien presentada, una pausa a tiempo, algo rico para compartir. Nuestra misión es transformar la pausa corporativa en un momento de bienestar y cercanía. Por eso conversamos contigo sobre tu equipo y lo que necesita antes de preparar una propuesta.', image: '/images/eventos/288e57d1-5ffc-4370-aa44-71ae84f87b60.JPG', alt: 'Garzones preparando el salón y las mesas para un evento de Divina Pausa', caption: 'Los detalles también son una forma de recibir.' },
  { id: 'encuentro', label: 'El encuentro', title: 'La mesa está lista. El momento es de ustedes.', text: 'Hoy enfocamos nuestra propuesta en coffee break, brunch y almuerzos para empresas en Santiago. Queremos seguir creando momentos auténticos que hagan más amable la jornada y den a las personas una ocasión para encontrarse.', image: '/images/eventos/IMG_1287.jpeg', alt: 'Mesa preparada por Divina Pausa para compartir durante un evento', caption: 'Coffee break, brunch y almuerzos para compartir.' },
];
---
<BaseLayout title="Nosotros: las personas detrás de Divina Pausa" description="Conoce a los fundadores de Divina Pausa y nuestra manera de cuidar cada encuentro. Coffee break, brunch y almuerzos para empresas en Santiago." ogImage={founders}>
  <div class="about">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="hero-copy">
        <p class="eyebrow">DIVINA PAUSA · NOSOTROS</p>
        <h1 id="about-title">Una pausa.<br />Muchas formas de <em>conectar.</em></h1>
        <div class="hero-bottom"><p>Nos gusta lo que sucede alrededor de una mesa: la conversación, las sonrisas y ese momento en que el trabajo deja espacio para compartir.</p><a class="text-link" href="#historia">Conoce nuestra historia <span aria-hidden="true">↓</span></a></div>
      </div>
      <figure class="founder-portrait">
        <img src={founders} alt="Los fundadores de Divina Pausa preparando juntos el catering de un evento" width="1280" height="960" fetchpriority="high" loading="eager" decoding="async" data-preload />
        <figcaption><span>Las personas detrás de la mesa</span><span aria-hidden="true">01 — DP</span></figcaption>
      </figure>
    </section>

    <section class="story" id="historia" aria-labelledby="story-title">
      <header class="story-heading"><p class="eyebrow">NUESTRA HISTORIA, EN LOS DETALLES</p><h2 id="story-title">Primero las personas.<br /><em>Después, todo lo demás.</em></h2></header>
      <div class="story-layout">
        <aside class="story-visual" aria-label="Fotografías de nuestra historia">
          <div class="photo-stack">
            {chapters.map((chapter, i) => <figure class:list={['story-photo', {active: i === 0}]} data-photo={i} aria-hidden={i !== 0 ? 'true' : 'false'}><img src={chapter.image} alt={chapter.alt} width="1280" height="960" loading="lazy" decoding="async" /><figcaption>{chapter.caption}</figcaption></figure>)}
          </div>
          <nav class="chapter-links" aria-label="Capítulos de nuestra historia">{chapters.map((chapter, i) => <a href={`#${chapter.id}`} data-chapter-link={i} aria-current={i === 0 ? 'step' : undefined}><span>0{i + 1}</span>{chapter.label}</a>)}</nav>
        </aside>
        <div class="chapters">
          <div class="story-track" aria-hidden="true"><span></span></div>
          {chapters.map((chapter, i) => <article class="chapter" id={chapter.id} data-chapter={i}><span class="chapter-number">0{i + 1}</span><p class="eyebrow">{chapter.label}</p><h3>{chapter.title}</h3><p class="chapter-copy">{chapter.text}</p><figure class="mobile-photo"><img src={chapter.image} alt={chapter.alt} width="1280" height="960" loading="lazy" decoding="async" /><figcaption>{chapter.caption}</figcaption></figure></article>)}
        </div>
      </div>
    </section>

    <section class="pause" aria-labelledby="pause-title">
      <div class="pause-copy"><p class="eyebrow">ESTÁS AQUÍ. DATE UN MOMENTO.</p><h2 id="pause-title">Las buenas ideas<br />también necesitan<br /><em>una pausa.</em></h2><p>Antes de seguir, un pequeño respiro.</p><button type="button" class="pause-button">Haz una pausa <span aria-hidden="true">✳</span></button><p class="pause-status" role="status" aria-live="polite">Pulsa y mira cómo florece.</p></div>
      <div class="bloom" aria-hidden="true"><div class="bloom-ring"></div>{Array.from({length: 8}, (_, i) => <div class="petal-arm" style={`transform: rotate(${i * 45}deg)`}><span class="petal"></span></div>)}<span class="bloom-center">DP</span></div>
    </section>

    <section class="principles" aria-labelledby="principles-title"><header><p class="eyebrow">NUESTRA MANERA DE HACER</p><h2 id="principles-title">Cercanía que se nota.<br /><em>Cuidado que se comparte.</em></h2></header><div class="principle-grid">
      <article><span>01 / ESCUCHAR</span><h3>Tu evento empieza contigo.</h3><p>Nos cuentas la ocasión, las personas y tus preferencias. Desde ahí construimos la propuesta.</p></article>
      <article><span>02 / PREPARAR</span><h3>Una mesa con intención.</h3><p>El menú y la presentación forman parte del mismo cuidado: que tu equipo se sienta bien recibido.</p></article>
      <article><span>03 / COMPARTIR</span><h3>Espacio para encontrarse.</h3><p>Coffee break, brunch o almuerzo. Tres maneras de hacer una pausa y disfrutar juntos.</p></article>
    </div></section>
    <CTASection />
  </div>
</BaseLayout>
<style>
  .about { --paper: #f7f3ee; --ink: #212121; --rose: #e5b1ae; color: var(--ink); background: var(--paper); position: relative; }
  .about h1,.about h2,.about h3 { font-family: var(--font-display); font-weight: 400; letter-spacing: -.025em; }
  .about em { font-weight: 400; }
  .about p { line-height: 1.8; }
  .eyebrow { font-family: var(--font-primary); font-size: .68rem; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; margin: 0 0 24px; }
  .about-hero { padding: 72px clamp(28px,5vw,80px) 80px; display: grid; grid-template-columns: 1.05fr 1fr; gap: 6vw; align-items: center; }
  h1 { font-size: clamp(3.4rem,5.8vw,6.5rem); line-height: .98; margin: 0 0 36px; }
  h1 em { color: #995751; }
  .hero-bottom p { max-width: 40ch; font-size: .92rem; margin-bottom: 26px; }
  .text-link { display: inline-flex; gap: 28px; align-items: center; color: var(--ink); text-decoration: none; border-bottom: 1px solid #21212160; padding: 12px 0; font-size: .8rem; }
  .founder-portrait { margin: 0; position: relative; padding: 12px; border: 1px solid #b38c833f; border-radius: 180px 180px 24px 24px; }
  .founder-portrait img { width: 100%; height: clamp(380px,43vw,620px); object-fit: cover; object-position: 62% center; border-radius: 170px 170px 15px 15px; display: block; }
  .founder-portrait figcaption { display: flex; justify-content: space-between; gap: 14px; font-size: .62rem; padding: 16px 8px 5px; }
  .story { padding: 88px clamp(28px,5vw,80px); background: var(--ink); color: var(--paper); scroll-margin-top: 150px; }
  .story-heading { margin-bottom: 60px; }
  .story h2,.story h3 { color: var(--paper); }
  .story-heading .eyebrow { color: #d6c1b9; }
  .story h2,.principles h2 { font-size: clamp(2.5rem,4.5vw,5rem); line-height: 1.12; margin: 0; }
  .story h2 em { color: var(--rose); }
  .story-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; align-items: start; }
  .story-visual { position: sticky; top: 165px; }
  .photo-stack { position: relative; aspect-ratio: 1.12; }
  .story-photo { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; }
  .story-photo.active { opacity: 1; visibility: visible; }
  .story-photo img { width: 100%; height: calc(100% - 42px); object-fit: cover; object-position: 62% center; border-radius: 22px; }
  .story-photo figcaption,.mobile-photo figcaption { color: #d9c7bf; font-size: .72rem; margin-top: 12px; }
  .chapter-links { display: flex; gap: 20px; margin-top: 18px; border-top: 1px solid #ffffff25; padding-top: 20px; }
  .chapter-links a { display: flex; flex-direction: column; gap: 8px; color: #ccc; font-size: .7rem; text-decoration: none; flex: 1; }
  .chapter-links span { font-size: .6rem; }
  .chapter-links a[aria-current] { color: var(--rose); }
  .chapters { position: relative; padding-left: 34px; }
  .story-track { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: #ffffff20; }
  .story-track span { display: block; width: 100%; height: 100%; background: var(--rose); transform-origin: top; }
  .chapter { min-height: 65svh; display: flex; flex-direction: column; justify-content: center; padding: 50px 0 100px; scroll-margin-top: 165px; }
  .chapter-number { color: var(--rose); font-family: var(--font-display); font-size: 4rem; line-height: 1; margin-bottom: 28px; }
  .chapter .eyebrow { margin-bottom: 16px; color: #d6c1b9; }
  .chapter h3 { font-size: clamp(2rem,3.2vw,3.8rem); line-height: 1.12; margin: 0 0 24px; }
  .chapter-copy { max-width: 45ch; font-size: .9rem; color: #e2ddd9; margin: 0; }
  .mobile-photo { display: none; }
  .pause { overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 50px; padding: 100px clamp(28px,8vw,130px); background: var(--rose); }
  .pause h2 { font-size: clamp(3rem,5vw,5.8rem); line-height: 1.02; margin: 0 0 24px; }
  .pause-copy > p:not(.eyebrow) { font-size: .85rem; }
  .pause-button { padding: 15px 24px; background: var(--ink); color: var(--paper); border: 1px solid var(--ink); border-radius: 50px; font: inherit; font-size: .82rem; cursor: pointer; display: inline-flex; align-items: center; gap: 28px; margin-top: 12px; }
  .pause-button span { font-size: 1.4rem; }
  .pause-status { min-height: 3.6em; max-width: 35ch; }
  .bloom { width: min(100%,420px); aspect-ratio: 1; position: relative; justify-self: center; }
  .bloom-ring { position: absolute; inset: 0; border: 1px solid #21212140; border-radius: 50%; }
  .petal-arm { position: absolute; inset: 0; }
  .petal { position: absolute; width: 27%; height: 46%; left: 36.5%; top: 4%; background: #212121; border: 1px solid #e5b1ae; border-radius: 50%; transform-origin: 50% 100%; transform: scale(.7); }
  .bloom-center { position: absolute; inset: 39%; display: grid; place-items: center; background: var(--paper); border-radius: 50%; font-family: var(--font-display); font-size: 1.7rem; }
  .principles { padding: 100px clamp(28px,5vw,80px); }
  .principles header { margin-bottom: 54px; }
  .principle-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 36px; }
  .principle-grid article { border-top: 1px solid #21212150; padding-top: 25px; }
  .principle-grid span { font-size: .62rem; letter-spacing: .13em; }
  .principle-grid h3 { font-size: 2rem; line-height: 1.16; margin: 24px 0 16px; }
  .principle-grid p { font-size: .85rem; max-width: 40ch; }
  a:focus-visible,button:focus-visible { outline: 3px solid #995751; outline-offset: 6px; }
  @media(max-width: 900px) {
    .about-hero { gap: 30px; padding-top: 45px; }
    .story-layout { gap: 35px; }
    .chapter-links { gap: 10px; }
    .pause { gap: 24px; padding-inline: 28px; }
  }
  @media(max-width: 700px) {
    .about-hero { grid-template-columns: 1fr; padding: 45px 24px 50px; }
    h1 { font-size: clamp(3.3rem,12vw,5rem); margin-bottom: 24px; }
    .eyebrow { font-size: .6rem; }
    .founder-portrait { border-radius: 100px 100px 22px 22px; }
    .founder-portrait img { border-radius: 90px 90px 14px 14px; height: auto; aspect-ratio: 1.1; object-position: 62% center; }
    .story { padding: 60px 24px; }
    .story-heading { margin-bottom: 38px; }
    .story-layout { display: block; }
    .story-visual { display: none; }
    .chapter { min-height: 0; padding: 14px 0 60px; }
    .chapter:last-child { padding-bottom: 0; }
    .chapters { padding-left: 22px; }
    .chapter h3 { font-size: 2.25rem; }
    .chapter-number { font-size: 3rem; margin-bottom: 18px; }
    .mobile-photo { display: block; margin: 24px 0 0; }
    .mobile-photo img { width: 100%; height: auto; aspect-ratio: 1.1; object-fit: cover; border-radius: 18px; }
    .pause { grid-template-columns: 1fr; padding: 60px 28px; gap: 16px; }
    .bloom { width: min(80%,290px); }
    .pause h2 { font-size: 3.4rem; }
    .principles { padding: 60px 28px; }
    .principle-grid { grid-template-columns: 1fr; gap: 30px; }
    .principles header { margin-bottom: 32px; }
    .principle-grid h3 { margin-top: 16px; }
  }
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('.about')!;
  const motion = gsap.matchMedia();
  const button = root.querySelector<HTMLButtonElement>('.pause-button')!;
  const status = root.querySelector<HTMLElement>('.pause-status')!;
  let bloomAnimation: gsap.core.Timeline | undefined;
  const bloom = (event: MouseEvent) => {
    bloomAnimation?.kill();
    status.textContent = 'Un respiro. Y seguimos compartiendo.';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || event.detail === 0) return;
    bloomAnimation = gsap.timeline();
    bloomAnimation.to('.petal', {scale:1, duration: .8, stagger: .035, ease:'power3.out'})
      .to('.bloom-ring', {scale:1.12, opacity:0, duration:.9, ease:'power2.out'},0)
      .to('.bloom-center', {rotation:180, duration:1.2, ease:'power2.inOut'},0)
      .to('.petal', {scale:.7, duration:1.3, stagger:.025, ease:'sine.inOut'},1.5)
      .to('.bloom-ring', {scale:1, opacity:1, duration:1},1.5)
      .to('.bloom-center', {rotation:0, duration:1.2,ease:'power2.inOut'},1.5);
  };
  button.addEventListener('click', bloom);
  motion.add({ reduced:'(prefers-reduced-motion: reduce)', desktop:'(min-width: 701px)' }, context => {
    const {reduced,desktop} = context.conditions!;
    const photos = [...root.querySelectorAll<HTMLElement>('.story-photo')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]')];
    const activate = (index: number) => {
      photos.forEach((photo,i) => { photo.classList.toggle('active', i===index); photo.setAttribute('aria-hidden',String(i!==index)); });
      links.forEach((link,i) => { if(i===index) link.setAttribute('aria-current','step'); else link.removeAttribute('aria-current'); });
      if (!reduced) gsap.fromTo(photos[index], {opacity:0,y:12}, {opacity:1,y:0,duration:.45,overwrite:true,ease:'power2.out'});
    };
    if (desktop) root.querySelectorAll<HTMLElement>('.chapter').forEach((chapter,i) => ScrollTrigger.create({trigger:chapter,start:'top 55%',end:'bottom 55%',onEnter:()=>activate(i),onEnterBack:()=>activate(i)}));
    if (reduced) return;
    gsap.from('.founder-portrait', {y:24,rotation:2,opacity:0,duration:.8,ease:'power3.out'});
    root.querySelectorAll<HTMLElement>('.chapter, .principle-grid article').forEach(element => gsap.from(element,{y:30,opacity:0,duration:.65,ease:'power3.out',scrollTrigger:{trigger:element,start:'top 88%',once:true}}));
    gsap.fromTo('.story-track span',{scaleY:0},{scaleY:1,ease:'none',scrollTrigger:{trigger:'.chapters',start:'top 65%',end:'bottom 75%',scrub:true}});
    gsap.fromTo('.bloom',{rotation:-25},{rotation:25,ease:'none',scrollTrigger:{trigger:'.pause',start:'top bottom',end:'bottom top',scrub:1}});
  });
  const refresh = () => ScrollTrigger.refresh();
  document.fonts.ready.then(refresh);
  window.addEventListener('load',refresh,{once:true});
  const cleanup = () => { motion.revert(); bloomAnimation?.kill(); button.removeEventListener('click',bloom); window.removeEventListener('load',refresh); };
  document.addEventListener('astro:before-swap',cleanup,{once:true});
  if(import.meta.hot) import.meta.hot.dispose(cleanup);
</script>
