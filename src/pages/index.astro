---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import LogoCloud from "../components/LogoCloud.astro";
import EventGallery from "../components/EventGallery.astro";
import CTASection from "../components/CTASection.astro";

import { standardServices, processSteps } from "../data/servicesData";

import "../styles/page-index.css";

---

<style>
  /* ── All sections above fixed hero-bg ── */
  :global(.servicios__process),
  :global(.servicios__intro),
  :global(.servicios__standard),
  :global(.servicios__divider),
  :global(.servicios__premium),
  :global(.calculadora),
  :global(#cta-section),
  :global(.testimonial-section),
  :global(.footer-section) {
    position: relative;
    z-index: 1;
  }

  /* ── Calculadora: fondo blanco tras la tarjeta oscura
     (el .calculadora es dark; el padding extiende el fondo
     blanco arriba/abajo, que antes quedaba descubierto por el
     margin vertical colapsado hacia el hero-bg fixed) ── */
  .calculadora-section {
    position: relative;
    z-index: 1;
    background-color: var(--color-white);
    padding: var(--space-2xl) 0;
  }

  /* ── Section spacing ── */
  .section-divider {
    width: 100%;
    height: 1px;
    background: var(--color-border);
    margin: 0;
  }

  /* ── Reduced motion safety ── */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<BaseLayout
  title="Catering en Santiago: coffee break, brunch y barra móvil"
  description="Coffee break, brunch, almuerzos corporativos y barra móvil en Santiago. Cuéntanos qué estás organizando y recibe una propuesta para tu evento."
  keywords="catering, barra móvil, coffee break, brunch, almuerzos corporativos, eventos, empresas, santiago, chile"
>
  <!-- ════════════════════════════════════════════
       1. HERO — Diagonal composition Awwwards-style
       ════════════════════════════════════════════ -->
  <HeroSection />

  <!-- Se activa automáticamente cuando se agregan logos en src/assets/clientes. -->
  <LogoCloud />

  <EventGallery />

  <!-- ════════════════════════════════════════════
       2. PROCESO "CÓMO TRABAJAMOS" — migrado de /servicios
       ════════════════════════════════════════════ -->
  <section class="servicios__process">
    <div class="servicios__process-header">
      <span class="servicios__process-label">Nuestro Proceso</span>
      <h2 class="servicios__process-title">Cómo Trabajamos</h2>
    </div>
    <div
      class="servicios__process-grid"
      id="process-slider"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Etapas de nuestro proceso"
      tabindex="0"
    >
      <span class="servicios__process-line" aria-hidden="true"></span>
      {processSteps.map((step, i) => (
        <article
          class="servicios__process-step"
          data-step={i}
          aria-label={`Paso ${i + 1} de ${processSteps.length}`}
        >
          <span class="servicios__process-number">{step.number}</span>
          <div class="servicios__process-content">
            <h3 class="servicios__process-step-title">{step.title}</h3>
            <p class="servicios__process-step-desc">{step.description}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="servicios__process-controls" aria-label="Controles del proceso">
      <button type="button" data-process-prev aria-label="Ver paso anterior">←</button>
      <p aria-live="polite"><span data-process-current>1</span> / {processSteps.length}</p>
      <button type="button" data-process-next aria-label="Ver paso siguiente">→</button>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. SERVICIOS — Intro + calculables + premium
       (migrado de /servicios)
       ════════════════════════════════════════════ -->
  <section class="servicios__intro">
    <div class="servicios__intro-inner">
      <span class="servicios__intro-label">Catálogo</span>
      <h2 class="servicios__intro-title">Propuestas Gastronómicas</h2>
      <p class="servicios__intro-desc">Coffee break para una reunión, brunch para compartir, almuerzos para tu equipo o una barra móvil para acompañar el evento. Cuéntanos la ocasión y preparamos una propuesta para ti.</p>
    </div>
  </section>

  <section class="servicios__standard" id="servicios-estandar">
    <div class="servicios__standard-inner">
      <div class="servicios__standard-grid">
        {standardServices.map((s, index) => {
          return (
            <article class="servicios__standard-card">
              <img class="servicios__standard-card-img" src={s.imgSrc} alt={s.imgAlt} decoding="async" loading="lazy" />
              <div class="servicios__standard-card-overlay"></div>
              <span class="service-index" aria-hidden="true">0{index + 1} / DIVINA PAUSA</span>
              <div class="servicios__standard-card-body">
                <h3 class="servicios__standard-card-title">{s.title}</h3>
                <p class="servicios__standard-card-description">{s.description}</p>
                <div class="service-detail">{s.pricingId === 'coffee-break' ? 'Para reuniones, capacitaciones y pausas de trabajo.' : s.pricingId === 'brunch' ? 'Para encuentros de equipo y celebraciones a media mañana.' : s.pricingId === 'barra-movil' ? 'Una estación de bebidas para sumar un punto de encuentro.' : 'Para jornadas corporativas y encuentros alrededor de la mesa.'}</div>
              </div>
              <div class="servicios__standard-card-footer">
                <a class="servicios__standard-card-btn" href="#calculadora" aria-label={`Cotizar ${s.title}`} data-quote-service={s.pricingId} data-cta="servicio">
                  <span>Cotizar</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>

              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Testimonios provisionales: reemplazar por contenido oficial aprobado. -->
  <!-- Testimonios pendientes de recibir y validar con clientes reales. -->

  <!-- El formulario de cotización reutiliza la calculadora sin mostrar precios. -->
  <div id="cta-section" style="background-color: #ffffff; position: relative; z-index: 1;">
    <CTASection />
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { setupPageAnimations } from "../utils/gsapInit";

  // Animaciones de entrada de los servicios.
  setupPageAnimations(() => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReduced) {
    /* ── PROCESO: stagger steps (migrado de /servicios) ── */
    gsap.from(".servicios__process-header", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".servicios__process",
        start: "top 80%",
        toggleActions: "play none none none",
        once: true,
      }
    });

    gsap.from(".servicios__process-step", {
      y: 60,
      opacity: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".servicios__process-grid",
        start: "top 80%",
        toggleActions: "play none none none",
        once: true,
      },
      onStart: () => {
        gsap.fromTo(".servicios__process-line", { scaleX: 0 }, { scaleX: 1, duration: 1.1, ease: "power2.inOut", delay: 0.35 });
      }
    });

    /* ── PROCESO: number reveal ── */
    gsap.from(".servicios__process-number", {
      scale: 0.4,
      opacity: 0,
      duration: 0.6,
      stagger: 0.15,
      ease: "back.out(1.7)",
      scrollTrigger: {
        trigger: ".servicios__process-grid",
        start: "top 80%",
        toggleActions: "play none none none",
        once: true,
      }
    });

    /* ── INTRO ── */
    gsap.from(".servicios__intro-label", {
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".servicios__intro",
        start: "top 80%"
      }
    });

    gsap.from(".servicios__intro-title", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".servicios__intro",
        start: "top 80%"
      }
    });

    gsap.from(".servicios__intro-desc", {
      y: 30,
      opacity: 0,
      duration: 0.8,
      delay: 0.2,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".servicios__intro",
        start: "top 80%"
      }
    });

    // Each card enters when visible, including stacked mobile layouts.
    gsap.utils.toArray<HTMLElement>(".servicios__standard-card, .servicios__premium-card").forEach((card) => {
      gsap.from(card, {
        y: 32,
        opacity: 0,
        duration: .65,
        ease: "power3.out",
        clearProps: "transform,opacity",
        scrollTrigger: {
          trigger: card,
          start: "top 92%",
          once: true,
        }
      });
    });
    }


  });

  const processSlider = document.getElementById("process-slider");
  const processSlides = processSlider
    ? Array.from(processSlider.querySelectorAll<HTMLElement>(".servicios__process-step"))
    : [];
  const processCurrent = document.querySelector<HTMLElement>("[data-process-current]");
  const previousButton = document.querySelector<HTMLButtonElement>("[data-process-prev]");
  const nextButton = document.querySelector<HTMLButtonElement>("[data-process-next]");

  const updateProcessCurrent = () => {
    if (!processSlider || !processCurrent || processSlides.length === 0) return;
    const sliderCenter = processSlider.scrollLeft + processSlider.clientWidth / 2;
    let nearestIndex = 0;
    let nearestDistance = Number.POSITIVE_INFINITY;
    processSlides.forEach((slide, index) => {
      const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
      const distance = Math.abs(sliderCenter - slideCenter);
      if (distance < nearestDistance) {
        nearestIndex = index;
        nearestDistance = distance;
      }
    });
    processCurrent.textContent = String(nearestIndex + 1);
  };

  const moveProcess = (direction: -1 | 1) => {
    if (!processSlider || processSlides.length === 0) return;
    const current = Number(processCurrent?.textContent ?? "1") - 1;
    const target = Math.min(processSlides.length - 1, Math.max(0, current + direction));
    processSlides[target].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
  };

  previousButton?.addEventListener("click", () => moveProcess(-1));
  nextButton?.addEventListener("click", () => moveProcess(1));
  processSlider?.addEventListener("scroll", updateProcessCurrent, { passive: true });
  processSlider?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      moveProcess(event.key === "ArrowLeft" ? -1 : 1);
    }
  });

  // ── Global: refresh ScrollTrigger after everything loads ──
  requestAnimationFrame(() => {
    ScrollTrigger.refresh();
  });
</script>
