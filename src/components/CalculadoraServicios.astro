---
import { quoteOptions } from '../data/quoteOptions';
import { CALCULATOR_LIMITS } from '../data/pricingData';
const images = ['/images/services/coffee.jpeg', '/images/services/brunch.png', '/images/services/almuerzo-gourmet-2.jpg', '/images/services/after-office.jpg', '/images/services/tablas.jpg', '/images/services/service-paella.jpg'];
const isPreview = process.env.VERCEL_ENV === 'preview';
const standardOptions = quoteOptions.filter(service => ['coffee-break', 'brunch', 'almuerzo'].includes(service.id));
---
<div class="quote" id="calculadora">
  <form id="quote-form" data-preview={isPreview ? "true" : undefined} novalidate>
    {isPreview && <p class="hint">Vista previa: puedes recorrer el formulario. No introduzcas datos personales; el envío está desactivado.</p>}
    <ol class="steps" aria-label="Pasos de tu cotización">
      {['Tu servicio', 'Tu evento', 'Tus datos'].map((title, i) => <li aria-current={i === 0 ? 'step' : undefined}><button type="button" data-go-step={i} aria-label={`Paso ${i + 1}: ${title}`} aria-current={i === 0 ? 'step' : undefined}><span>0{i + 1}</span><b class="step-label">{title}</b></button></li>)}
    </ol>
    <div class="step-panels">
    <fieldset data-step="0" tabindex="-1">
      <legend>¿Qué te gustaría servir?</legend>
      <p class="hint" id="service-hint">Elige un servicio para pasar a los detalles de tu evento.</p>
      <div class="options">
        {standardOptions.map((service, index) => (
          <label class="option">
            <img src={images[index]} alt="" loading="lazy" width="480" height="320" />
            <input type="radio" name="services" value={service.id} aria-describedby="service-hint" />
            <span class="option-copy"><strong>{service.title}</strong><small>{service.description}</small><i aria-hidden="true">Elegir servicio ↗</i></span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset data-step="1" tabindex="-1" hidden inert>
      <legend>Démosle forma a tu evento</legend>
      <p class="hint">Ajusta la cantidad de invitados y las horas de servicio.</p>
      <div class="event-controls">
        {[{name:'people', title:'Personas', min:CALCULATOR_LIMITS.minPeople, max:CALCULATOR_LIMITS.maxPeople, step:CALCULATOR_LIMITS.peopleStep, value:CALCULATOR_LIMITS.defaultPeople}, {name:'hours', title:'Horas de servicio', min:CALCULATOR_LIMITS.minHours, max:CALCULATOR_LIMITS.maxHours, step:CALCULATOR_LIMITS.hoursStep, value:CALCULATOR_LIMITS.defaultHours}].map(control => (
          <div class="quantity">
            <label for={`quote-${control.name}`}>{control.title}</label>
            <div class="counter">
              <button type="button" data-adjust={control.name} data-direction="-1" aria-label={`Reducir ${control.title.toLowerCase()}`}>−</button>
              <output id={`${control.name}-value`} for={`quote-${control.name}`}>{control.value}</output>
              <button type="button" data-adjust={control.name} data-direction="1" aria-label={`Aumentar ${control.title.toLowerCase()}`}>+</button>
            </div>
            <input id={`quote-${control.name}`} name={control.name} type="range" min={control.min} max={control.max} step={control.step} value={control.value} />
            <div class="range-labels"><span>{control.min}</span><span>{control.max}</span></div>
          </div>
        ))}
      </div>
    </fieldset>
    <fieldset class="details" data-step="2" tabindex="-1" hidden inert>
      <legend>¿Cómo podemos contactarte?</legend>
      <p class="selection-summary hint"></p>
      <div class="fields">
        <label>Nombre <span aria-hidden="true">*</span><input name="name" autocomplete="name" maxlength="120" required /></label>
        <label>Correo electrónico <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
        <label class="phone">Teléfono <small>(opcional)</small><input name="phone" type="tel" autocomplete="tel" maxlength="30" placeholder="+56 9" /></label>
      </div>
      <p class="hint">Usaremos tus datos para responder a esta solicitud de cotización.</p>
    </fieldset>
    <div class="navigation">
      <button class="back" type="button" hidden>← Volver</button>
      <button class="next submit" type="button" hidden>Continuar <span aria-hidden="true">→</span></button>
      <button class="submit" type="submit" hidden>Enviar cotización <span aria-hidden="true">↗</span></button>
    </div>
    </div>
    <div class="honeypot" aria-hidden="true"><label>Empresa web<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p id="quote-status" role="status" aria-live="polite"></p>
    <noscript><p>Activa JavaScript para enviar el formulario o escríbenos a contacto@divinapausa.cl.</p></noscript>
  </form>
  <div class="success" id="quote-success" hidden inert tabindex="-1">
    <span class="success-icon" aria-hidden="true">✓</span>
    <h3>¡Gracias por invitarnos a tu evento!</h3>
    <p>Recibimos tu solicitud. Te contactaremos por correo para preparar tu cotización.</p>
    <button type="button" id="quote-again">Preparar otra solicitud</button>
  </div>
  <div class="confetti" aria-hidden="true"></div>
</div>
<style>
  .quote { position: relative; display: grid; width: 100%; max-width: none; margin: auto; padding: clamp(20px, 3vw, 36px); border-radius: 28px; background: var(--color-dark); color: white; overflow: hidden; overflow-anchor: none; scroll-margin-top: 165px; }
  #quote-form, .success { grid-area: 1 / 1; min-width: 0; }
  .step-panels { display: grid; min-height: 290px; }
  .step-panels > fieldset { grid-area: 1 / 1; align-self: center; width: 100%; }
  .step-panels > fieldset:not([data-step="0"]) { padding-bottom: 78px; }
  .step-panels > fieldset[data-step="0"] { align-self: center; display: flex; flex-direction: column; }
  .step-panels > fieldset[data-step="0"] .options { height: 340px; }
  .step-panels > fieldset[data-step="0"] .option img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .step-panels > fieldset[data-step="0"] .option > span { padding: 24px; }
  .step-panels .navigation { grid-area: 1 / 1; align-self: end; z-index: 1; margin-top: 0; pointer-events: none; }
  .navigation button { pointer-events: auto; }
  @media (hover: hover) and (pointer: fine) { .option:hover { background: #e5b1ae19; border-color: var(--color-primary); } }
  .quote .step-panels > fieldset[hidden], .quote #quote-form[hidden], .quote .success[hidden] { display: block !important; visibility: hidden; pointer-events: none; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 12px; }
  .hint { font-size: .82rem; color: #d5cecb; line-height: 1.6; margin: 0 0 18px; }
  .options { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; }
  [hidden] { display: none !important; }
  #quote-form { scroll-margin-top: 165px; }
  .steps { position: relative; display: flex; justify-content: space-between; list-style: none; padding: 0; margin: 0 0 24px; isolation: isolate; }
  .steps::before, .steps::after { content: ''; position: absolute; top: 21px; left: 42px; right: 42px; height: 1px; background: #ffffff30; z-index: -1; }
  .steps::after { background: var(--color-primary); transform: scaleX(var(--step-progress, 0)); transform-origin: left; transition: transform 360ms cubic-bezier(.22,1,.36,1); }
  .steps li { width: 84px; display: flex; flex-direction: column; align-items: center; gap: 10px; color: #aaa; font-size: .8rem; text-align: center; }
  .steps button { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .steps button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 5px; border-radius: 8px; }
  .step-label { font-weight: 400; min-height: 2.8em; line-height: 1.4; }
  .steps li[aria-current], .steps li[data-complete] { color: var(--color-primary); }
  .steps span { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid currentColor; border-radius: 50%; background: var(--color-dark); }
  .steps li[aria-current] span { background: var(--color-primary); color: var(--color-dark); border-color: var(--color-primary); }
  .steps.instant::after { transition: none; }
  @media(prefers-reduced-motion: reduce) { .steps::after { transition: none; } }
  .option { position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 0; border: 1px solid #e5b1ae70; border-radius: 22px; overflow: hidden; cursor: pointer; background: #ffffff05; }
  .option::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #21212100 15%, #212121ee 100%); z-index: 1; }
  .option::after { content: ''; position: absolute; inset: 7px; border: 1px solid #ffffff26; border-radius: 16px; z-index: 2; pointer-events: none; }
  .option-copy { position: relative; z-index: 2; }
  .option-copy strong { font-family: var(--font-display); font-size: clamp(1.6rem, 2.4vw, 2.3rem); font-weight: 400; }
  .option-copy i { display: block; margin-top: 18px; color: var(--color-primary); font-size: .72rem; font-style: normal; letter-spacing: .05em; }
  @media (hover: hover) and (pointer: fine) {
    .option img { transition: transform 320ms cubic-bezier(.22,1,.36,1); }
    .option:hover img { transform: scale(1.035); }
  }
  @media (prefers-reduced-motion: reduce) { .option img { transition: none; } .option:hover img { transform: none; } }
  .option img { width: 100%; height: 130px; object-fit: cover; }
  .option > span { padding: 16px; }
  .option input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .event-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0; }
  .quantity { padding: 18px; border: 1px solid #ffffff25; border-radius: 20px; background: #ffffff05; }
  .quantity > label { display: block; text-align: center; color: #ded5d1; }
  .counter { display: flex; align-items: center; justify-content: space-between; margin: 12px 0; gap: 12px; }
  .counter output { font-family: var(--font-display); font-size: 4rem; color: var(--color-primary); }
  .counter button { width: 44px; height: 44px; border: 1px solid #ffffff40; border-radius: 50%; background: transparent; color: white; font-size: 1.5rem; cursor: pointer; }
  .counter button:disabled { opacity: .3; cursor: default; }
  .quote input[type="range"] { width: 100%; padding: 0; accent-color: var(--color-primary); border: 0; background: transparent; cursor: pointer; }
  .range-labels { display: flex; justify-content: space-between; font-size: .75rem; color: #aaa; }
  .navigation { display: flex; justify-content: flex-end; align-items: center; gap: 16px; margin-top: 30px; }
  .navigation { min-height: 50px; }
  .back { background: transparent; color: white; border: 0; padding: 14px 0; margin-right: auto; font: inherit; cursor: pointer; }
  .navigation .submit { width: auto; }
  @media(max-width: 600px) { .event-controls { grid-template-columns: 1fr; } .quantity { padding: 18px; } .steps li { font-size: .7rem; } .option img { height: 105px; } .option > span { padding: 12px; } .navigation { gap: 10px; } .navigation .submit { padding: 14px 18px; } }
  .option:has(input:checked) { border-color: var(--color-primary); box-shadow: inset 0 0 0 2px var(--color-primary); background: #e5b1ae19; }
  .option:has(input:focus-visible) { outline: 2px solid white; outline-offset: 3px; }
  strong { display: block; font-size: .9rem; }
  .option small { display: block; color: #d5cecb; line-height: 1.5; margin-top: 7px; font-size: .78rem; }
  .people { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 26px 0; margin: 12px 0 26px; border-bottom: 1px solid #ffffff25; }
  .people input { width: 110px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 8px 0 24px; }
  .fields label { display: flex; flex-direction: column; gap: 8px; font-size: .85rem; }
  .fields label > span { display: none; }
  .fields small { color: #d5cecb; }
  input:not([type="checkbox"]):not([type="radio"]) { border: 1px solid #ffffff55; border-radius: 10px; background: #ffffff08; color: white; padding: 12px; min-height: 48px; font: inherit; min-width: 0; }
  input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .submit, .success button { border: 0; min-height: 50px; padding: 14px 28px; border-radius: 50px; background: var(--color-primary); color: #212121; font: inherit; font-weight: 600; cursor: pointer; }
  .submit { display: flex; align-items: center; justify-content: center; gap: 20px; width: 100%; }
  .submit:disabled { opacity: .65; cursor: wait; }
  #quote-status { margin: 12px 0 0; line-height: 1.6; font-size: .9rem; height: 3.2em; overflow-y: auto; }
  .honeypot { position: absolute; left: -10000px; }
  .success { text-align: center; padding: 24px 0; align-self: center; }
  .success h3 { font-family: var(--font-display); font-size: 2.3rem; font-weight: 400; margin: 24px 0 16px; }
  .success p { color: #ddd; line-height: 1.7; margin-bottom: 28px; }
  .success-icon { font-size: 3rem; color: var(--color-primary); }
  .confetti { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .confetti :global(i) { position: absolute; left: 50%; top: 55%; width: 8px; height: 14px; border-radius: 2px; }
  @media(max-width: 767px) {
    .options { grid-template-columns: 1fr; gap: 10px; }
    .option { flex-direction: row; align-items: center; }
    .option img { width: 28%; height: 88px; flex-shrink: 0; }
    .step-panels > fieldset[data-step="0"] .options { height: 240px; grid-auto-rows: minmax(0, 1fr); }
    .step-panels > fieldset[data-step="0"] .option small { display: none; }
    .step-panels > fieldset[data-step="0"] .option img { position: absolute; width: 100%; height: 100%; }
    .option::before { background: linear-gradient(90deg, #212121ed, #21212155); }
    .step-panels > fieldset[data-step="0"] .option > span { padding: 12px 20px; width: 100%; }
    .option-copy strong { font-size: 1.45rem; }
    .option-copy i { margin-top: 4px; font-size: .65rem; }
    .option > span { padding: 10px 12px; }
    .option small { margin-top: 4px; }
    .fields { grid-template-columns: 1fr; gap: 12px; margin-bottom: 12px; }
    .fields label { gap: 5px; }
    .fields .phone { display: block; }
    .fields .phone input { display: block; width: 100%; margin-top: 5px; }
    .counter output { font-size: 2.6rem; }
    .counter { margin: 4px 0; }
    .quantity { padding: 12px 16px; }
    .event-controls { gap: 10px; }
    .quote input[type="range"] { min-height: 28px; }
    .navigation { margin-top: 20px; }
    legend { font-size: 1.45rem; }
    .steps { margin-bottom: 18px; }
  }
</style>
<script>
  import { gsap } from 'gsap';
  const form = document.querySelector<HTMLFormElement>('#quote-form')!;
  const status = document.querySelector<HTMLElement>('#quote-status')!;
  const success = document.querySelector<HTMLElement>('#quote-success')!;
  const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
  let requestId = crypto.randomUUID();
  let pending = false;
  let submittedPayload = '';
  let currentStep = 0;
  const quote = document.querySelector<HTMLElement>('#calculadora')!;
  let anchoredScroll: number | null = null;
  const alignIfMoved = () => {
    if (anchoredScroll === null || Math.abs(window.scrollY - anchoredScroll) > 3) {
      const top = quote.getBoundingClientRect().top + window.scrollY;
      const availableHeight = window.innerHeight - 165;
      const offset = 165 + Math.max(0, (availableHeight - quote.offsetHeight) / 2);
      window.scrollTo({ top: Math.max(0, top - offset), behavior: 'instant' });
      anchoredScroll = window.scrollY;
    }
  };
  const panels = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const back = form.querySelector<HTMLButtonElement>('.back')!;
  const next = form.querySelector<HTMLButtonElement>('.next')!;
  let furthestStep = 0;
  const updateQuantities = () => {
    for (const input of form.querySelectorAll<HTMLInputElement>('[type="range"]')) {
      form.querySelector<HTMLOutputElement>(`#${input.name}-value`)!.value = input.value;
      for (const button of form.querySelectorAll<HTMLButtonElement>(`[data-adjust="${input.name}"]`)) {
        button.disabled = button.dataset.direction === '-1' ? +input.value <= +input.min : +input.value >= +input.max;
      }
    }
  };
  const showStep = (step: number, animate = false) => {
    if (pending) return;
    const direction = step >= currentStep ? 1 : -1;
    currentStep = step;
    furthestStep = Math.max(furthestStep, step);
    panels.forEach((panel, index) => { panel.hidden = index !== step; panel.inert = index !== step; });
    const progress = form.querySelector<HTMLElement>('.steps')!;
    progress.classList.toggle('instant', !animate);
    progress.style.setProperty('--step-progress', String(step / 2));
    form.querySelectorAll('.steps li').forEach((item, index) => {
      item.toggleAttribute('data-complete', index < step);
      if (index === step) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      const button = item.querySelector('button')!;
      button.disabled = index > furthestStep;
      if (index === step) button.setAttribute('aria-current', 'step');
      else button.removeAttribute('aria-current');
    });
    back.hidden = step === 0;
    next.hidden = step !== 1;
    submit.hidden = step !== 2;
    status.textContent = '';
    const data = new FormData(form);
    const selected = [...form.querySelectorAll<HTMLInputElement>('[name="services"]:checked')].map(input => input.closest('label')!.querySelector('strong')!.textContent);
    const labels = [selected[0] || 'Tu servicio', step === 2 ? `${data.get('people')} personas · ${data.get('hours')} h` : 'Tu evento', 'Tus datos'];
    form.querySelectorAll<HTMLButtonElement>('[data-go-step]').forEach((button, index) => {
      button.querySelector('.step-label')!.textContent = labels[index];
      button.setAttribute('aria-label', `Paso ${index + 1}: ${labels[index]}`);
    });
    form.querySelector('.selection-summary')!.textContent = `${selected.join(' · ')} — ${data.get('people')} personas · ${data.get('hours')} horas`;
    panels[step].focus({ preventScroll: true });
    alignIfMoved();
    panels[step].getAnimations().forEach(animation => animation.cancel());
    if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) panels[step].animate([{opacity:0,transform:`translateX(${direction * 30}px)`},{opacity:1,transform:'translateX(0)'}], {duration:360,easing:'cubic-bezier(.22,1,.36,1)'});
  };
  const navigateTo = (step: number, animate = false) => {
    if (pending || step === currentStep) return;
    if (step > 0 && !form.querySelector('[name="services"]:checked')) {
      status.textContent = 'Selecciona al menos un servicio para continuar.';
      form.querySelector<HTMLInputElement>('[name="services"]')?.focus();
      return;
    }
    showStep(step, animate);
  };
  form.querySelectorAll<HTMLButtonElement>('[data-go-step]').forEach(button => {
    button.disabled = Number(button.dataset.goStep) > 0;
    button.addEventListener('click', event => navigateTo(Number(button.dataset.goStep), event.detail > 0));
  });
  form.querySelectorAll<HTMLInputElement>('[name="services"]').forEach(input => {
    input.addEventListener('click', event => {
      if (input.checked) navigateTo(1, event.detail > 0);
    });
    input.addEventListener('change', () => { if (input.checked && currentStep === 0) navigateTo(1); });
  });
  next.addEventListener('click', event => navigateTo(2, event.detail > 0));
  document.querySelectorAll<HTMLAnchorElement>('[data-quote-service]').forEach(link => {
    link.addEventListener('click', event => {
      const input = [...form.querySelectorAll<HTMLInputElement>('[name="services"]')].find(input => input.value === link.dataset.quoteService);
      if (!input) return;
      event.preventDefault();
      if (pending) return;
      input.checked = true;
      success.hidden = true;
      success.inert = true;
      form.hidden = false;
      form.inert = false;
      anchoredScroll = null;
      showStep(1, event.detail > 0);
      history.replaceState(null, '', '#calculadora');
    });
  });
  back.addEventListener('click', event => showStep(Math.max(0, currentStep - 1), event.detail > 0));
  form.querySelectorAll<HTMLInputElement>('[type="range"]').forEach(input => input.addEventListener('input', updateQuantities));
  form.querySelectorAll<HTMLButtonElement>('[data-adjust]').forEach(button => button.addEventListener('click', () => {
    const input = form.querySelector<HTMLInputElement>(`[name="${button.dataset.adjust}"]`)!;
    if (button.dataset.direction === '1') input.stepUp(); else input.stepDown();
    updateQuantities();
  }));
  updateQuantities();
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (currentStep < 2) { navigateTo(currentStep + 1); return; }
    if (form.dataset.preview === 'true') {
      status.textContent = 'Esta es una vista previa. No se ha enviado ni guardado ninguna cotización.';
      return;
    }
    if (pending || !form.reportValidity()) return;
    const data = new FormData(form);
    const payload = {
      services: data.getAll('services'),
      people: Number(data.get('people')),
      hours: Number(data.get('hours')),
      name: String(data.get('name') || '').trim(),
      email: String(data.get('email') || '').trim(),
      phone: String(data.get('phone') || '').trim(),
      website: String(data.get('website') || ''),
    };
    if (!payload.services.length || !payload.name) {
      status.textContent = !payload.services.length ? 'Selecciona al menos un servicio.' : 'Escribe tu nombre.';
      form.querySelector<HTMLInputElement>(!payload.services.length ? '[name="services"]' : '[name="name"]')?.focus();
      return;
    }
    if (payload.phone && !/^[+()\d\s.-]{6,30}$/.test(payload.phone)) {
      status.textContent = 'Revisa tu teléfono: utiliza números y, si corresponde, el código de país.';
      form.querySelector<HTMLInputElement>('[name="phone"]')?.focus();
      return;
    }
    const serialized = JSON.stringify(payload);
    if (submittedPayload && submittedPayload !== serialized) requestId = crypto.randomUUID();
    submittedPayload = serialized;
    pending = true;
    submit.disabled = true;
    form.setAttribute('aria-busy', 'true');
    status.textContent = 'Guardando tu solicitud…';
    try {
      const response = await fetch('/api/cotizaciones', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...payload, requestId }),
        signal: AbortSignal.timeout(25000),
      });
      const result = await response.json();
      if (response.status === 429 && result.code === 'rate_limited') {
        const minutes = Math.max(1, Math.ceil(Number(result.retryAfter || 900) / 60));
        status.textContent = `Ya enviaste 3 cotizaciones en esta sesión. Puedes enviar otra en ${minutes} minuto${minutes === 1 ? '' : 's'}. Tus selecciones siguen aquí.`;
        return;
      }
      if (!response.ok || result.ok !== true || result.requestId !== requestId) throw new Error('not-saved');
      form.hidden = true;
      form.inert = true;
      success.hidden = false;
      success.inert = false;
      success.focus({ preventScroll: true });
      alignIfMoved();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const layer = document.querySelector<HTMLElement>('.confetti')!;
        const colors = ['#e5b1ae', '#fff', '#a8615d', '#ffe5e3'];
        for (let i = 0; i < 55; i++) {
          const piece = document.createElement('i');
          piece.style.background = colors[i % colors.length];
          layer.append(piece);
          gsap.to(piece, { x: (Math.random() - .5) * layer.clientWidth * 1.6, y: -100 - Math.random() * 260, rotation: Math.random() * 360, duration: .65, ease: 'power2.out', onComplete: () => {
            gsap.to(piece, { y: layer.clientHeight, rotation: '+=180', opacity: 0, duration: 1.4 + Math.random(), ease: 'power2.in', onComplete: () => piece.remove() });
          } });
        }
      }
    } catch {
      status.textContent = 'No pudimos confirmar el guardado. Tus datos siguen aquí: vuelve a intentarlo o escríbenos a contacto@divinapausa.cl.';
    } finally {
      pending = false;
      submit.disabled = false;
      form.removeAttribute('aria-busy');
    }
  });
  document.querySelector('#quote-again')?.addEventListener('click', () => {
    form.reset();
    furthestStep = 0;
    requestId = crypto.randomUUID();
    submittedPayload = '';
    status.textContent = '';
    success.hidden = true;
    success.inert = true;
    form.hidden = false;
    form.inert = false;
    updateQuantities();
    showStep(0);
    form.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  });
</script>
