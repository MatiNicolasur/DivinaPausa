---
const testimonials = [
  { quote: "Trabajamos con Divina Pausa para el lanzamiento de un producto y la experiencia fue impecable. El coffee break personalizado con opciones sin gluten y veganas fue todo un acierto: nuestros invitados destacaron la calidad y la presentación.", name: "Valentina Muñoz", role: "Directora de Marketing — Cornershop", initials: "VM" },
  { quote: "Necesitábamos catering para una capacitación de tres días con 80 personas. El equipo cumplió con los horarios y respondió bien incluso cuando tuvimos cambios de último minuto.", name: "Rodrigo Álvarez", role: "HR Business Partner — Mercado Libre", initials: "RA" },
  { quote: "Entendieron el tono de nuestra celebración de fin de año y armaron una propuesta de cocina en vivo que se convirtió en el centro del encuentro. Valoramos mucho su profesionalismo y cercanía.", name: "Carolina Sepúlveda", role: "Jefa de Cultura — WOM", initials: "CS" },
  { quote: "Contratamos coffee breaks semanales para el equipo. Llegaban puntuales, con opciones distintas, frescas y bien presentadas. La coordinación fue clara durante todo el servicio.", name: "Felipe González", role: "Head of Operations — Buk", initials: "FG" },
  { quote: "Organicé un after office para 50 personas y todo fluyó desde la cotización hasta el servicio en terreno. Las tablas, los bocados y la barra ayudaron a crear el ambiente que buscábamos.", name: "Javiera Pizarro", role: "Eventos Corporativos — Entel", initials: "JP" },
];

---

<section class="testimonial-section" aria-labelledby="testimonial-title">
  <header class="testimonial-header">
    <p class="testimonial-label"><span aria-hidden="true"></span>Testimonios</p>
    <h2 id="testimonial-title">Lo que dicen nuestros clientes</h2>
  </header>
  <div class="testimonial-viewport">
    <div class="testimonial-track">
      {[false, true].map((duplicate) => (
        <div class="testimonial-group" aria-hidden={duplicate ? "true" : undefined}>
          {testimonials.map((testimonial) => (
            <article class="testimonial-card">
              <div class="testimonial-stars" role="img" aria-label="5 estrellas">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z" /></svg>
                ))}
              </div>
              <blockquote>{testimonial.quote}</blockquote>
              <footer>
                <span class="testimonial-avatar" aria-hidden="true">{testimonial.initials}</span>
                <div>
                  <h3>{testimonial.name}</h3>
                  <p>{testimonial.role}</p>
                </div>
              </footer>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-section { position: relative; z-index: 1; padding: clamp(64px, 8vw, 100px) 0; overflow: hidden; background: var(--color-dark); }
  .testimonial-header { margin: 0 auto 52px; padding: 0 24px; text-align: center; }
  .testimonial-label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; color: var(--color-primary); font-size: .7rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }
  .testimonial-label span { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .testimonial-header h2 { margin: 0; color: #fff; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 400; line-height: 1.15; }
  .testimonial-viewport { overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); }
  .testimonial-track { display: flex; gap: 24px; width: max-content; animation: testimonial-loop 58s linear infinite; }
  .testimonial-group { display: flex; gap: 24px; }
  .testimonial-card { width: 380px; padding: 36px 32px 28px; display: flex; flex-direction: column; border-radius: 16px; background: #fff; box-shadow: 0 4px 24px rgba(0,0,0,.15); }
  .testimonial-stars { display: flex; gap: 3px; margin-bottom: 20px; color: var(--color-primary); }
  .testimonial-stars svg { width: 18px; height: 18px; }
  .testimonial-card blockquote { flex: 1; margin: 0 0 24px; color: #444; font-size: .9rem; line-height: 1.7; }
  .testimonial-card footer { display: flex; align-items: center; gap: 14px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,.06); }
  .testimonial-avatar { width: 44px; height: 44px; flex: 0 0 44px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(135deg, var(--color-primary), #c99592); font-size: .9rem; font-weight: 700; }
  .testimonial-card h3 { margin: 0; color: var(--color-text); font-size: .95rem; font-weight: 600; line-height: 1.3; }
  .testimonial-card footer p { margin: 2px 0 0; color: #616161; font-size: .78rem; line-height: 1.3; }
  .testimonial-section:where(:hover, :focus-within) .testimonial-track,
  .testimonial-section:not(.is-visible) .testimonial-track { animation-play-state: paused; }
  @keyframes testimonial-loop { to { transform: translateX(calc(-50% - 12px)); } }

  @media (max-width: 767px) {
    .testimonial-header { margin-bottom: 36px; }
    .testimonial-viewport { overflow-x: auto; padding: 0 24px 12px; scroll-padding-inline: 24px; scroll-snap-type: x mandatory; scrollbar-width: none; mask-image: none; -webkit-mask-image: none; }
    .testimonial-viewport::-webkit-scrollbar { display: none; }
    .testimonial-track { animation: none; transform: none; }
    .testimonial-group { gap: 14px; }
    .testimonial-group[aria-hidden="true"] { display: none; }
    .testimonial-card { width: min(78vw, 310px); padding: 26px 22px 22px; scroll-snap-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-viewport { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    .testimonial-track { animation: none; transform: none; }
    .testimonial-group[aria-hidden="true"] { display: none; }
  }
</style>

<script>
  const testimonialSection = document.querySelector<HTMLElement>(".testimonial-section");
  if (testimonialSection) {
    const observer = new IntersectionObserver(([entry]) => {
      testimonialSection.classList.toggle("is-visible", entry.isIntersecting);
    });
    observer.observe(testimonialSection);
  }
</script>
